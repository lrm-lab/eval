+def write_batch_report(output, planned=None, *, evidence_store_dir=None):
+    with publish_v2.publish_lock(output):
+        if not (output / "episodes.jsonl").is_file():
+            print(f"Skipping batch report & v2 manifest sealing: missing episodes.jsonl in {output}", file=sys.stderr)
+            return
+        try:
+            _, rows, metadata, status = batch_report.read_batch(output)
+            if not (output / "batch-status.json").is_file():
+                status = {"status": "finished", "planned": planned or len(rows), "completed": len(rows)}
+                atomic_write(output / "batch-status.json", (json.dumps(status, ensure_ascii=False, indent=2) + "\n").encode())
+            official = output / "official-result.json"
+            result = batch_report.summarize(rows, metadata, status, planned=planned,
+                                            official=official if official.is_file() else None)
+            batch_report.write_report(output / "batch-report.json",
+                                      json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + "\n")
+        except (OSError, ValueError, TypeError, KeyError) as error:
+            print(f"Could not write batch report: {error}", file=sys.stderr)
+            raise
+        if not (output / "batch-report.json").is_file():
+            raise RuntimeError(f"Missing required batch-report.json after report generation: {output}")
+        publish_v2.write_trial_digests_and_manifest_v2(
+            output,
+            batch_name=output.name,
+            evidence_store_dir=evidence_store_dir,
+        )
 
 
